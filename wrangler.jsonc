{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "website-interface",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Keeps next/image optimization working at the edge. The garden art ships as
  // 3.6-4.5MB source PNGs and depends on being resized and re-encoded to
  // AVIF/WebP per request; without this binding those would be served raw.
  "images": {
    "binding": "IMAGES"
  }
}
