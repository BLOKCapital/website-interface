{
  "name": "website-interface",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "browserslist": [
    "defaults",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "firefox esr"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ci": "npm run build && playwright test",
    "check:classes": "node scripts/check-classes.mjs",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "~15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-config-next": "~15.5.27",
    "postcss": "^8.4.47",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "playwright-core": "1.62.1"
  }
}
